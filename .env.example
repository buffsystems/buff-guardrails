# Written by ./install.sh — edit by hand if you prefer. docker compose reads this file
# literally: keep comments on their own lines.

# --- model behind LiteLLM: a backend inside your perimeter, or none (masking + demo only).
# Local Ollama (compose profile "ollama"):  LLM_MODEL=ollama_chat/gemma3:4b  LLM_API_BASE=http://ollama:11434
# Local vLLM (profile "vllm", NVIDIA GPU):  LLM_MODEL=hosted_vllm/Qwen/Qwen3-8B  LLM_API_BASE=http://vllm:8000/v1
# Your own OpenAI-compatible server:        LLM_MODEL=openai/<served name>  LLM_API_BASE=http://host:port/v1
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=none

# compose profiles to start with plain `docker compose up`: ollama | vllm | (empty)
COMPOSE_PROFILES=
# add docker-compose.gpu.yml for an NVIDIA GPU: COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
COMPOSE_FILE=docker-compose.yml
OLLAMA_MODEL=gemma3:4b
VLLM_MODEL=Qwen/Qwen3-8B

# --- LiteLLM proxy (admin UI + API on LITELLM_PORT; log in with the master key)
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-me-too
POSTGRES_PASSWORD=litellm

# --- analyzer (CPU). See README «Модели / Models» for the NER options.
GUARDRAILS_LANGUAGES=ru,en
# spacy | none
GUARDRAILS_NER=spacy
GUARDRAILS_SCORE_THRESHOLD=0.35
GUARDRAILS_DICTIONARY=/app/conf/dictionary.yaml
# Passwords and secrets: cascade (regexes + bardsai judge, 0.7 MB, recommended) |
# cascade-strict (the judge only filters, fewer false spans) | rules (regexes only) |
# none (provider key formats only). The model is downloaded into the models volume on first start.
GUARDRAILS_SECRETS=cascade
# Optional self-hosted NER models, downloaded into the models volume on first start.
# GLiNER (classic): e.g. urchade/gliner_multi_pii-v1
GUARDRAILS_GLINER_MODEL=
# Hugging Face token-classification model: e.g. redmadrobot-rnd/rubert-base-pii-ner
GUARDRAILS_HF_NER_MODEL=
# Its label → Presidio entity map, e.g. FIRST_NAME=PERSON,LAST_NAME=PERSON,MIDDLE_NAME=PERSON,CITY=LOCATION,STREET=ADDRESS,HOUSE=ADDRESS
GUARDRAILS_HF_NER_MAPPING=

# --- ports on the host
LITELLM_PORT=4000
DEMO_PORT=8080
ANALYZER_PORT=3000
